generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SlotKind {
  BOOKING
  BLOCK
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Service {
  id           String        @id @default(cuid())
  barbershopId String
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id])
  name         String
  duration     Int
  price        Int
  description  String
  active       Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([barbershopId, name])
}

model Barber {
  id           String          @id @default(cuid())
  barbershopId String
  barbershop   Barbershop      @relation(fields: [barbershopId], references: [id])
  name         String
  role         String
  bio          String
  active       Boolean         @default(true)
  appointments Appointment[]
  blocks       ScheduleBlock[]
  slots        ScheduleSlot[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([barbershopId])
}

model Appointment {
  id           String            @id @default(cuid())
  customerId   String
  serviceId    String
  barberId     String
  date         DateTime          @db.Date
  time         String
  duration     Int
  status       AppointmentStatus @default(CONFIRMED)
  customer     Customer          @relation(fields: [customerId], references: [id])
  service      Service           @relation(fields: [serviceId], references: [id])
  barber       Barber            @relation(fields: [barberId], references: [id])
  slots        ScheduleSlot[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([barberId, date, time])
  @@index([customerId, date])
}

model ScheduleBlock {
  id        String         @id @default(cuid())
  barberId  String
  date      DateTime       @db.Date
  time      String
  duration  Int
  note      String
  barber    Barber         @relation(fields: [barberId], references: [id])
  slots     ScheduleSlot[]
  createdAt DateTime       @default(now())
}

model ScheduleSlot {
  id            String         @id @default(cuid())
  barberId      String
  date          DateTime       @db.Date
  time          String
  kind          SlotKind
  appointmentId String?
  blockId       String?
  barber        Barber         @relation(fields: [barberId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  block         ScheduleBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([barberId, date, time])
  @@index([appointmentId])
  @@index([blockId])
}

// ── BarberOS: barberías que compran licencia del software ──
enum BarbershopStatus {
  PENDING_PAYMENT
  ACTIVE
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

model Barbershop {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  ownerName String
  email     String
  phone     String
  city      String
  plan      String
  status    BarbershopStatus @default(PENDING_PAYMENT)
  // La licencia vale mientras paidUntil sea futura; vencida = paidUntil en el pasado.
  paidUntil DateTime?
  // Vacío = el dueño todavía no puede entrar a su panel.
  passwordHash String        @default("")
  // Tema de la página pública y del panel: callejero | clasico | minimal. accent es un color #rrggbb opcional.
  theme     String           @default("callejero")
  accent    String           @default("")
  heroImage String           @default("")
  address   String           @default("")
  mapsUrl   String           @default("")
  whatsapp  String           @default("")
  instagram String           @default("")
  payments  Payment[]
  barbers   Barber[]
  services  Service[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([email])
}

model Payment {
  id                    String        @id @default(cuid())
  reference             String        @unique
  barbershopId          String
  barbershop            Barbershop    @relation(fields: [barbershopId], references: [id])
  plan                  String
  period                String
  amountInCents         Int
  currency              String        @default("COP")
  // Hoy solo Wompi; el campo deja lugar a otra pasarela para vender fuera de Colombia.
  provider              String        @default("wompi")
  providerTransactionId String?
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}
