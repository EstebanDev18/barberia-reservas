{
  "name": "barberia-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "node -r ts-node/register/transpile-only --test test/fixes.test.ts",
    "prisma:generate": "prisma generate --schema prisma/platform/schema.prisma && prisma generate --schema prisma/tenant/schema.prisma",
    "db:migrate:platform": "prisma migrate deploy --schema prisma/platform/schema.prisma",
    "db:migrate:tenants": "ts-node scripts/migrate-tenants.ts",
    "db:migrate": "pnpm db:migrate:platform && pnpm db:migrate:tenants",
    "db:new-migration:platform": "prisma migrate dev --create-only --schema prisma/platform/schema.prisma",
    "db:new-migration:tenant": "prisma migrate dev --create-only --schema prisma/tenant/schema.prisma",
    "db:seed": "ts-node prisma/seed.ts",
    "db:split": "ts-node scripts/split-databases.ts",
    "postinstall": "prisma generate --schema prisma/platform/schema.prisma && prisma generate --schema prisma/tenant/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.9",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/throttler": "6.7.1",
    "helmet": "8.3.0",
    "@nestjs/platform-express": "11.2.9",
    "@prisma/client": "6.16.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "prisma": "6.16.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.2.9",
    "@types/node": "24.5.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  }
}
