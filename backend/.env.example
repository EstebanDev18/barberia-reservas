# Base de la plataforma (barberías, licencias, pagos)
PLATFORM_DATABASE_URL="postgresql://barberia:barberia@localhost:5432/barberos_platform?schema=public"
# Plantilla para la base propia de cada barbería: {db} se reemplaza por barberos_shop_<id>. El usuario necesita permiso CREATEDB.
TENANT_DATABASE_URL_TEMPLATE="postgresql://barberia:barberia@localhost:5432/{db}?schema=public"
# Solo para crear migraciones nuevas del esquema de barbería (pnpm db:new-migration:tenant)
TENANT_DATABASE_URL="postgresql://barberia:barberia@localhost:5432/barberos_tenant_dev?schema=public"
# Base única anterior: solo la lee pnpm db:split (queda como respaldo)
OLD_DATABASE_URL="postgresql://barberia:barberia@localhost:5432/barberia?schema=public"
PORT=3001
FRONTEND_URL="http://localhost:3000"
# Clave inicial del panel de Legacy Barber (solo la usa el seed; cada barbería nueva crea la suya al registrarse)
ADMIN_PASSWORD="cambia-esta-clave"
JWT_SECRET="cambia-este-secreto"

# BarberOS (venta del software)
PLATFORM_PASSWORD="cambia-esta-clave-de-barberos"
PUBLIC_SITE_URL="http://localhost:3000"
# Llaves de Wompi (Dashboard > Desarrolladores). Sin WOMPI_PUBLIC_KEY se usa el modo demo (solo fuera de producción).
WOMPI_PUBLIC_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
WOMPI_API_URL="https://sandbox.wompi.co/v1"
